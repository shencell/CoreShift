<Window x:Class="CoreShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="276" Height="392"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF121212"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#FF262626"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF5F5F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9E9E9E"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FF66BB6A"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF5350"/>

        <!-- The single large action tile: idle #1A1A1A, smoothly transitions to #1B5E20 on hover -->
        <Style x:Key="ToggleTileStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" CornerRadius="16" Padding="16">
                            <Border.Background>
                                <SolidColorBrush Color="#FF1A1A1A"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Tile"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#FF1B5E20" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Tile"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#FF1A1A1A" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Coding-mode (PowerShell) icon: visible only when at 100% -->
        <Style x:Key="CodingIconStyle" TargetType="Viewbox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCodingMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Gaming-mode (Controller) icon: visible only when at 99% -->
        <Style x:Key="GamingIconStyle" TargetType="Viewbox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCodingMode}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- GPU preset pills: idle #1A1A1A, hover fade like the main tile, solid green when active -->
        <Style x:Key="GpuPillStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="10" Padding="0,9" Margin="3,0"
                                BorderThickness="1.5" BorderBrush="Transparent">
                            <Border.Background>
                                <SolidColorBrush Color="#FF1A1A1A"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Pill"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#FF1B5E20" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Pill"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#FF1A1A1A" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <!-- Active preset: green hairline + accent text (background stays
                                 animation-owned by the hover storyboards) -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentTextBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Floating card with soft shadow (margin leaves room for the shadow to render) -->
    <Border Margin="16" CornerRadius="18"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="#FF000000"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Wordmark -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="CORE" Foreground="{StaticResource TextPrimary}"
                           FontWeight="SemiBold" FontSize="13" Opacity="0.9"/>
                <TextBlock Text="SHIFT" Foreground="{StaticResource AccentTextBrush}"
                           FontWeight="SemiBold" FontSize="13"/>
            </StackPanel>

            <!-- The single toggle tile -->
            <Button Grid.Row="1" x:Name="ToggleButton"
                    Style="{StaticResource ToggleTileStyle}"
                    Click="ToggleButton_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="60" Height="60" HorizontalAlignment="Center">

                        <!-- Coding Mode → PowerShell prompt glyph (chevron + underscore) -->
                        <Viewbox Style="{StaticResource CodingIconStyle}">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5,5 L13,12 L5,19"
                                      Stroke="{StaticResource TextPrimary}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                <Path Data="M13,19 L20,19"
                                      Stroke="{StaticResource TextPrimary}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Gaming Mode → Controller glyph -->
                        <Viewbox Style="{StaticResource GamingIconStyle}">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{StaticResource TextPrimary}"
                                      Data="F1 M21.58,16.09 L20.49,8.43 C20.21,6.46 18.52,5 16.53,5 L7.47,5 C5.48,5 3.79,6.46 3.51,8.43 L2.42,16.09 C2.2,17.63 3.39,19 4.94,19 C5.62,19 6.26,18.73 6.74,18.25 L9,16 L15,16 L17.25,18.25 C17.73,18.73 18.38,19 19.06,19 C20.61,19 21.8,17.63 21.58,16.09 Z M11,11 L9,11 L9,13 L8,13 L8,11 L6,11 L6,10 L8,10 L8,8 L9,8 L9,10 L11,10 Z M15,10 C14.45,10 14,9.55 14,9 C14,8.45 14.45,8 15,8 C15.55,8 16,8.45 16,9 C16,9.55 15.55,10 15,10 Z M17,13 C16.45,13 16,12.55 16,12 C16,11.45 16.45,11 17,11 C17.55,11 18,11.45 18,12 C18,12.55 17.55,13 17,13 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <TextBlock Text="{Binding ModeTitle}" Foreground="{StaticResource TextPrimary}"
                               FontWeight="SemiBold" FontSize="17"
                               HorizontalAlignment="Center" Margin="0,14,0,2"/>
                    <TextBlock Text="{Binding ModeSubtitle}" Foreground="{StaticResource TextSecondary}"
                               FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- GPU power-limit presets -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="{Binding GpuStatusLine}"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="10.5" HorizontalAlignment="Center"/>
                <UniformGrid Columns="3" Margin="-3,7,-3,0">
                    <Button Content="BASE" Click="GpuBase_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GpuPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGpuBase}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="LIGHT" Click="GpuLight_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GpuPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGpuLight}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="HEAVY" Click="GpuHeavy_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GpuPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGpuHeavy}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
            </StackPanel>

            <!-- Error / status line (empty in the happy path) -->
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       FontSize="10.5" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>
